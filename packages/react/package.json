{
  "name": "@tensorcost/ui-kit",
  "version": "1.1.0",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vaadhlabs/ui-kit.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "TensorCost design system \u2014 React components, MUI 7 theme, semantic tone palette, charts. The canonical UI kit for TensorCost apps, the marketing site, and slide pipelines.",
  "keywords": [
    "tensorcost",
    "design-system",
    "ui-kit",
    "react",
    "mui",
    "components"
  ],
  "homepage": "https://github.com/vaadhlabs/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/vaadhlabs/ui-kit/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tensorcost/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1",
    "jsdom": "^29.0.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
