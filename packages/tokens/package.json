{
  "name": "@tensorcost/tokens",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js",
      "require": "./dist/brand.cjs"
    },
    "./tone": {
      "types": "./dist/tone.d.ts",
      "import": "./dist/tone.js",
      "require": "./dist/tone.cjs"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js",
      "require": "./dist/typography.cjs"
    },
    "./css-vars": {
      "types": "./dist/css-vars.d.ts",
      "import": "./dist/css-vars.js",
      "require": "./dist/css-vars.cjs"
    },
    "./brand.json": "./src/brand.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vaadhlabs/ui-kit.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
